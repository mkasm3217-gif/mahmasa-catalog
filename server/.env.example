# Local MySQL 8 test settings. Copy to server/.env and fill in local credentials only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mahmasa_catalog_test

# Local-only test credentials; change before using the admin panel.
SESSION_SECRET=replace-with-a-long-random-local-test-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-local-test-password
NODE_ENV=development

# Optional for image-upload testing; leave blank if not testing uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional; browser push needs real VAPID keys. Never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:test@example.com
